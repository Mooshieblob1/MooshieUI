          "sources": [
            "anima"
          ]
        },
        {
          "label": "Ultra-wide perspective [Description]",
          "value": "An exaggerated wide-angle perspective makes nearby objects appear much larger than distant objects.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Natural perspective [Description]",
          "value": "The scene has natural proportions with little perspective distortion.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Telephoto compression [Description]",
          "value": "A compressed perspective makes the background appear close behind the subject.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Orthographic look [Description]",
          "value": "Parallel edges remain parallel and objects do not shrink noticeably with distance.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Macro detail [Description]",
          "value": "A tiny detail fills the frame and its fine surface texture is clearly visible.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Enlarged foreground [Description]",
          "value": "An object close to the viewer appears large while the subject and background recede behind it.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        },
        {
          "label": "Layered depth [Description]",
          "value": "Near objects overlap the subject and distant scenery to create clear layers of depth.",
          "kind": "description",
          "sources": [
            "anima"
          ]
        }
      ]
