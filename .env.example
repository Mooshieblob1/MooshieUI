# MooshieUI Server — Environment Variables
# Copy this file to .env and adjust as needed.

# Port to expose the web UI (default: 3200)
MOOSHIEUI_PORT=3200

# Host path to external models directory (optional)
# MODELS_PATH=./models

# Initial admin account (required on first run - users cannot self-register).
# Set a strong password before first launch. The server refuses to start an
# admin account when the password is empty or equals "changeme".
MOOSHIEUI_ADMIN_USER=admin
MOOSHIEUI_ADMIN_PASS=
# Example: MOOSHIEUI_ADMIN_PASS=MyStr0ngPassw0rd

# Optional TLS for the browser-mode web server (PEM files inside the container/host)
# MOOSHIEUI_TLS_CERT_PATH=/path/to/fullchain.pem
# MOOSHIEUI_TLS_KEY_PATH=/path/to/privkey.pem

# Requests from the server's own machine (localhost or an IP address) are the
# admin without signing in. Set to false when a proxy on the same machine or in
# the same network namespace (e.g. the cloudflared sidecar) rewrites Host to
# localhost and adds no X-Forwarded-For; everyone then signs in. It stays on
# until an admin account exists.
# MOOSHIEUI_TRUST_LOCALHOST=true

# Log level: error, warn, info, debug, trace
RUST_LOG=info

# Cloudflare Tunnel token (uncomment cloudflared service in docker-compose.yml)
# CLOUDFLARE_TUNNEL_TOKEN=
